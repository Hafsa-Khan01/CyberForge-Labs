index=lab ("Failed password" OR "authentication failure")
| rex field=_raw "from (?<src_ip>\\d{1,3}(?:\\.\\d{1,3}){3})"
| stats count as failures values(user) as targeted_users by src_ip
| sort - failures
| table src_ip failures targeted_users

# Detects SSH authentication failures grouped by source IP.
# MITRE: T1110 - Brute Force.
# L1 value: identifies sources producing repeated SSH failures.
# Adapt sourcetype and extraction to the actual auth.log event format.
# This aggregates over the selected time range; add time buckets for a threshold window.
